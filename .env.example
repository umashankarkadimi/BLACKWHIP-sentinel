NODE_ENV=development
PORT=8443

# Comma-separated list of allowed browser origins (CORS). Empty = same-origin
# only (the dashboard is served by this server). Example:
# CORS_ORIGINS=https://soc.example.com,https://soc.internal
CORS_ORIGINS=

# Secret used to sign login JWTs. Use a long random string (openssl rand -hex 32).
# NOTE: the server REFUSES to boot with a missing or placeholder value.
JWT_SECRET=your_jwt_secret_here

# First admin account. The server seeds/updates this user on boot with a bcrypt hash.
# NOTE: the server REFUSES to boot with a missing or placeholder password.
# Additional analysts/admins are provisioned by an admin via POST /api/users.
ADMIN_EMAIL=admin@company.com
ADMIN_PASSWORD=change_me_now

# Shared key that lets external endpoint agents / log forwarders POST real events to
# /api/events/ingest via the "X-Ingest-Key" header (no user login required).
INGEST_API_KEY=

# --- Wazuh manager API (agent inventory + host isolation via Active Response) ---
WAZUH_API_URL=https://wazuh.local:55000
WAZUH_API_USERNAME=wazuh_admin
WAZUH_API_PASSWORD=wazuh_pass
# Set to 'false' for self-signed lab certs. Defaults to TRUE outside NODE_ENV=development.
WAZUH_VERIFY_TLS=false

# --- OpenSearch / Wazuh Indexer (real alert stream, polled every 5s) ---
OPENSEARCH_URL=https://opensearch.local:9200
OPENSEARCH_USERNAME=admin
OPENSEARCH_PASSWORD=admin
# Index holding the real Wazuh alert stream (used by the collector and
# threat-hunting search). MUST match your indexer, e.g. wazuh-alerts-*
OPENSEARCH_ALERTS_INDEX=wazuh-alerts-4.*
# Set to 'false' for self-signed lab certs. Defaults to TRUE outside NODE_ENV=development.
OPENSEARCH_VERIFY_TLS=false

# --- Threat intelligence enrichment ---
VIRUSTOTAL_API_KEY=
OTX_API_KEY=

# --- Google Gemini ("Paul" AI). GEMINI_API_KEY preferred; PAUL_AI_API_KEY also accepted. ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
PAUL_AI_API_KEY=

# --- Demo/preview mode ---
# When true, the dashboard opens WITHOUT a login page: unauthenticated requests
# are treated as the seeded admin (ADMIN_EMAIL). NEVER enable in production.
AUTO_AUTH=false

# --- Structured logging (JSON lines) ---
# verbosity: debug | info | warn | error
LOG_LEVEL=info

# --- Outbound webhook notifications ---
# HIGH/CRITICAL alerts and new incidents are POSTed here as JSON
# ({type, timestamp, payload}). Works with Slack/Discord webhook URLs.
WEBHOOK_URL=

# --- Reverse proxy ---
# Set to 'true' ONLY when the server sits behind a reverse proxy that sets
# X-Forwarded-For. Enables correct client IPs for rate limiting + audit.
TRUST_PROXY=false
