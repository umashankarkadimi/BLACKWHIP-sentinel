NODE_ENV=development
PORT=8443

# Secret used to sign login JWTs. Use a long random string (openssl rand -hex 32).
JWT_SECRET=your_jwt_secret_here

# First admin account. The server seeds/updates this user on boot with a bcrypt hash.
ADMIN_EMAIL=admin@company.com
ADMIN_PASSWORD=change_me_now

# Shared key that lets external endpoint agents / log forwarders POST real events to
# /api/events/ingest via the "X-Ingest-Key" header (no user login required).
INGEST_API_KEY=

# --- Wazuh manager API (agent inventory + host isolation via Active Response) ---
WAZUH_API_URL=https://wazuh.local:55000
WAZUH_API_USERNAME=wazuh_admin
WAZUH_API_PASSWORD=wazuh_pass
WAZUH_VERIFY_TLS=false

# --- OpenSearch / Wazuh Indexer (real alert stream, polled every 5s) ---
OPENSEARCH_URL=https://opensearch.local:9200
OPENSEARCH_USERNAME=admin
OPENSEARCH_PASSWORD=admin
OPENSEARCH_VERIFY_TLS=false

# --- Threat intelligence enrichment ---
VIRUSTOTAL_API_KEY=
OTX_API_KEY=

# --- Google Gemini ("Paul" AI). GEMINI_API_KEY preferred; PAUL_AI_API_KEY also accepted. ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
PAUL_AI_API_KEY=
